# Server
PORT=5000
NODE_ENV=development

# MongoDB 
MONGO_URI=mongodb://localhost:27017/loader-shop
# For production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/LoaderShop?retryWrites=true&w=majority

# JWT (for custom auth if needed)
JWT_SECRET=your_jwt_secret_key_here

# Admin Secret (IMPORTANT - fallback auth)
ADMIN_SECRET=your_admin_secret_here

# Frontend
FRONTEND_URL=http://localhost:3000

# SSLCommerz (payment)
IS_LIVE=false
STORE_ID=your_store_id
STORE_PASSWORD=your_store_password

# bKash (payment)
BKASH_ENV=sandbox
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_PASSWORD=your_bkash_password

# Stripe (payment)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Firebase Admin SDK
# Download your service account key from Firebase Console
# Project Settings > Service Accounts > Generate New Private Key
# Save the file as "serviceAccountKey.json" in the server root folder
# The file is already in .gitignore, so it won't be committed
